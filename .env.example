# ---------------------------------------------------------------------------
# Every value here is optional. With an empty .env the app boots in demo mode:
# an in-process Postgres with seed data, a list-only view and auth disabled.
# ---------------------------------------------------------------------------

# Neon Postgres connection string. Without it the app uses in-memory PGlite.
DATABASE_URL=

# Clerk — https://dashboard.clerk.com. Both are required to enable sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Maps JavaScript API key (restrict it to your domain in the GCP console).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers. DEMO_MAP_ID works for local development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Where the map opens before the user shares their location (defaults to Shibuya).
NEXT_PUBLIC_DEFAULT_LAT=35.6580
NEXT_PUBLIC_DEFAULT_LNG=139.7016

# Ingest feeds: JSON array of { source, label, endpoint }.
INGEST_SOURCES=[]

# Shared secret for the scheduled ingest. The endpoint stays disabled until set.
CRON_SECRET=
